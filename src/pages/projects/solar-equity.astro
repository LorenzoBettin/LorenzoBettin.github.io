  .end { padding-top: 110px; padding-bottom: 120px; }
  .end h2 { margin-bottom: 32px; }
  .button {
    display: inline-block; padding: 16px 25px;
    background: #18253b; color: white; border-radius: 8px;
    font-size: 14px; font-weight: 600;
  }
  .button:hover { background: #3979e6; }
  footer { border-top: 1px solid #e3e9f0; }
  .footer-content {
    display: flex; justify-content: space-between; gap: 16px;
