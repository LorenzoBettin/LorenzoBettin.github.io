
---
const tools = ["Python", "pandas", "GeoPandas", "scikit-learn", "statsmodels", "Spatial Analysis"];

const sources = [
  { name: "Eurostat — Solar photovoltaic data", url: "https://ec.europa.eu/eurostat/databrowser/view/nrg_ind_pehnf/default/table?lang=en" },
  { name: "JRC — Solar energy potential", url: "https://data.jrc.ec.europa.eu/collection/id-00138" },
  { name: "World Bank — GDP", url: "https://data.worldbank.org/indicator/NY.GDP.MKTP.CD" },
  { name: "Our World in Data — Solar PV prices", url: "https://ourworldindata.org/grapher/solar-pv-prices" },
  { name: "Eurostat — Population", url: "https://ec.europa.eu/eurostat/web/population-demography" },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Solar Equity: analysing drivers of solar energy adoption across Europe." />
  <title>Solar Equity | Lorenzo Bettin</title>
</head>
<body>
  <header>
    <nav class="container nav">
      <a href="/" class="logo">Lorenzo Bettin<span>.</span></a>
      <div class="nav-links">
        <a href="/#projects">Projects</a>
        <a href="/#about">About</a>
        <a href="https://github.com/LorenzoBettin" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
    </nav>
  </header>

  <main>
    <section class="hero container">
      <a href="/#projects" class="back">← All projects</a>
      <div class="eyebrow">ENERGY POLICY / SPATIAL DATA SCIENCE</div>
      <h1>Solar <span>Equity.</span></h1>
      <p class="subtitle">
        Understanding the socio-spatial drivers of solar energy adoption
        across the European Union.
      </p>

      <div class="tags">
        {tools.map(tool => <span>{tool}</span>)}
      </div>


<a
  href="https://github.com/LorenzoBettin/solar-equity"
  target="_blank"
  rel="noopener noreferrer"
  class="source-link"
>
  View Source Code on GitHub ↗
</a>

    </section>

    <section class="overview">
      <div class="container">
        <div class="metrics">
          <div><strong>2014–2023</strong><span>Analysis period</span></div>
          <div><strong>230</strong><span>Country-year records</span></div>
          <div><strong>0.90</strong><span>Exploratory test R²</span></div>
        </div>

        <div class="content-grid">
          <div class="section-label">01 / OVERVIEW</div>
          <div>
            <h2>The challenge</h2>
            <p>
              Solar photovoltaic energy is central to Europe's energy
              transition. However, solar adoption varies substantially
              between countries, raising questions about the roles
              of economic, geographical and demographic factors.
            </p>
            <p>
              This project explores how these factors relate to
              differences in solar energy adoption, with the wider
              objective of informing more equitable energy policies.
            </p>
          </div>
        </div>

        <div class="content-grid">
          <div class="section-label">02 / RESEARCH</div>
          <div>
            <h2>Research question</h2>
            <blockquote>
              What are the socio-spatial factors influencing rooftop
              solar adoption across the EU, and how can these insights
              inform equitable policies?
            </blockquote>
            <p>
              The analysis considers solar energy potential, economic
              conditions, population characteristics, energy demand,
              PV module prices and educational attainment.
            </p>
          </div>
        </div>

        <div class="content-grid">
          <div class="section-label">03 / METHODOLOGY</div>
          <div>
            <h2>Analytical approach</h2>

            <div class="method">
              <span>01</span>
              <div>
                <h3>Data collection and integration</h3>
                <p>
                  Combined geographical boundaries with energy,
                  demographic and economic data from Eurostat,
                  the World Bank, JRC and other public sources.
                </p>
              </div>
            </div>

            <div class="method">
              <span>02</span>
              <div>
                <h3>Data preparation</h3>
                <p>
                  Examined missing values, harmonized country-year
                  observations and standardized numerical variables.
                </p>
              </div>
            </div>

            <div class="method">
              <span>03</span>
              <div>
                <h3>Exploratory data analysis</h3>
                <p>
                  Investigated photovoltaic trends over time,
                  country-level variation and potential outliers.
                </p>
              </div>
            </div>

            <div class="method">
              <span>04</span>
              <div>
                <h3>Statistical modelling</h3>
                <p>
                  Applied multiple linear regression and ordinary
                  least squares (OLS) to study relationships
                  between photovoltaic activity and the selected
                  explanatory variables.
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="content-grid">
          <div class="section-label">04 / FINDINGS</div>
          <div>
            <h2>Results and interpretation</h2>

              <figure class="project-figure">
                <img
                  src="/images/solar-equity/solar-trends-europe.png"
                  alt="Solar photovoltaic values over time across European countries"
                  loading="lazy"
                />
                <figcaption>
                  Solar photovoltaic trends across European countries,
                  reproduced from the original project analysis.
                </figcaption>
              </figure>

              <figure class="project-figure">
                <img
                  src="/images/solar-equity/actual-vs-predicted.png"
                  alt="Actual versus predicted solar photovoltaic values"
                  loading="lazy"
                />
                <figcaption>
                  Exploratory regression results: actual versus predicted
                  photovoltaic values. The dashed line represents
                  perfect predictions.
                </figcaption>
              </figure>


      


            <p>
              The exported notebook reports a test R² of approximately
              0.90 for its linear regression model.
            </p>
            <p>
              The fitted OLS model identified statistical associations
              involving GDP, population, energy consumption,
              technical solar potential and PV module prices.
              Tertiary education was not statistically significant
              in the reported specification.
            </p>
            <div class="note">
              <strong>Interpretation and limitations</strong>
              <p>
                These are exploratory associations, not causal effects.
                The model's validation and preprocessing choices would
                need further review before drawing strong predictive
                or policy conclusions.
              </p>
            </div>
          </div>
        </div>

        <div class="content-grid">
          <div class="section-label">05 / DATA SOURCES</div>
          <div>
            <h2>Research resources</h2>
            <p>Original public data sources referenced by the project.</p>
            <div class="sources">
              {sources.map(source => (
                <a href={source.url} target="_blank" rel="noopener noreferrer">
                  {source.name} <span>↗</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="end container">
      <div class="eyebrow">EXPLORE MORE</div>
      <h2>Interested in other projects?</h2>
      <a href="/#projects" class="button">Explore all projects →</a>
    </section>
  </main>

  <footer>
    <div class="container footer-content">
      <span>© {new Date().getFullYear()} Lorenzo Bettin</span>
      <a href="/">Back to homepage ↑</a>
    </div>
  </footer>
</body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) {
    margin: 0;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #18253b;
    -webkit-font-smoothing: antialiased;
  }
  :global(a) { color: inherit; text-decoration: none; }
  .container { max-width: 1100px; margin: auto; padding: 0 28px; }
  header { border-bottom: 1px solid #edf0f4; }
  .nav {
    height: 80px; display: flex; align-items: center;
    justify-content: space-between;
  }
